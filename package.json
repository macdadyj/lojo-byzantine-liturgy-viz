{
  "name": "lojo-byzantine-liturgy-viz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lab": "vite --open /lab",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run typecheck && npm test && vite build",
    "shots": "node scripts/shots.mjs",
    "shots:diff": "node scripts/shots-diff.mjs",
    "perf": "node scripts/perf.mjs",
    "phone": "node scripts/phone.mjs",
    "phone:faults": "node scripts/phone-faults.mjs",
    "shots:keep": "node scripts/shots-keep.mjs",
    "peek": "node scripts/peek.mjs",
    "stills": "node scripts/stills.mjs",
    "small-art": "node scripts/small-art.mjs"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.2.8",
    "@fontsource/public-sans": "^5.2.5",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jpeg-js": "^0.4.4",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
